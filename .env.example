# ============================================================
# Supabase
# ============================================================
# Crea un proyecto en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ============================================================
# Anthropic (Claude Haiku 4.5; plan Max: Claude Sonnet 5.5)
# ============================================================
# Crea tu API key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Google OAuth (Calendar)
# ============================================================
# https://console.cloud.google.com/apis/credentials
# Scope requerido: https://www.googleapis.com/auth/calendar
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============================================================
# Cifrado de tokens en BD (AES-256-GCM)
# ============================================================
# Genera con: pnpm gen:key (o `node scripts/gen-encryption-key.mjs`)
# Debe ser una clave de 32 bytes en base64
ENCRYPTION_KEY=

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Stripe (facturación: suscripción mensual + prueba de 14 días)
# ============================================================
# Claves: https://dashboard.stripe.com/apikeys (empieza en modo test: sk_test_...)
STRIPE_SECRET_KEY=
# Secreto del endpoint ${NEXT_PUBLIC_APP_URL}/api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# IDs de los precios mensuales recurrentes (price_...) de cada plan
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
